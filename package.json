{
  "name": "prosharness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @pros/dashboard exec next dev -H 127.0.0.1 -p 3000",
    "start": "pnpm --filter @pros/dashboard build && pnpm --filter @pros/dashboard exec next start -H 127.0.0.1 -p 3000",
    "pros": "tsx packages/cli/src/main.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:reset": "tsx scripts/seed-reset.ts"
  },
  "dependencies": {
    "@pros/barrier": "workspace:*",
    "@pros/plan": "workspace:*",
    "@pros/implement": "workspace:*",
    "@pros/index": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
